[node name="PickupItem" parent="." unique_id=2034020040 instance=ExtResource("3_x1fke")]
item_name = "Librarian's Log"
can_inspect = true
inspection_texture = ExtResource("4_0t1vi")
readable_text = "LIBRARIAN'S LOG
An old, dust-covered journal. Several pages are worn and yellowed.

**October 17 — Final Entry**
I've spent years preserving the history of this university. Every book on that shelf holds a piece of our past, from its humble beginnings to the final days recorded within these walls.
The books were never meant to be placed randomly. **History must follow the order in which it happened.** Only then will the shelf reveal what it has been keeping.
Something has always bothered me about the **1974 Yearbook**. Its pages look ordinary, yet it feels much heavier than any book of its size.
I once noticed a strange marking hidden among its pages, but my eyes could no longer make out the details.
And now, one of the history books has gone missing. I fear it may have been buried beneath the fallen debris.
*If someone finds this journal, remember: the past must be put back in its rightful place.*

— **The Librarian**"
can_open = false
contains_item = false
contained_item_name = "Magnifying Glass"

